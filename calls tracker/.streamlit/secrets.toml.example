# Copy this file to  secrets.toml  (same folder) and paste your sheet links.
#
# Just paste the NORMAL Google Sheets URL from your browser address bar — the app
# converts it to CSV automatically. No "Publish to web" needed.
#
# Setup:
#   1. Share the sheet: Share → General access → "Anyone with the link" → Viewer.
#   2. Click the TAB you want, then copy the URL from the address bar. It ends in
#      #gid=<number> — that number picks the tab, so the two links differ only by gid.
#
# ⚠️ "Anyone with the link" makes the sheet public to anyone who has the URL.
# Don't put respondent names / full phone numbers in the published tabs.
#
# Note: the dashboards drop rollup.HIDE_FROM_DASHBOARD (the `pitch` arm,
# `signup_scan`, `age`, `education`, `pre_symptom_*`) from everything they show
# or hand out — but that is a display filter, not a substitute for keeping
# genuinely sensitive fields off a link-shared sheet.

# Attempts tab (one row per call attempt)
sheet_csv_url = "https://docs.google.com/spreadsheets/d/PASTE-YOUR-OWN-SHEET-ID-HERE/edit?gid=249772860#gid=249772860"

# Sample / roster tab (one row per pid) — currently the DATA ENTRY tab.
# Its schema is documented in context/tracking_sheet_codebook.md section 4.
# rollup.py reads whichever vintage of the roster columns is present, so an older
# tab (rec_signup / phones_provided / is_* flags) still works unchanged.
sample_csv_url = "https://docs.google.com/spreadsheets/d/PASTE-YOUR-OWN-SHEET-ID-HERE/edit?gid=517204918#gid=517204918"

# --- password gate (auth.py) -------------------------------------------------
# Set this and BOTH dashboards ask for a password before showing anything.
# Leave it out / blank and they open to anyone, with a yellow warning on screen.
# One shared password for everyone with the link. Make it long; change it when
# someone leaves the team.
app_password = "choose-something-long-and-not-guessable"
